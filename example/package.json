{
  "name": "fprot-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "mkdist": "mkdir -p dist",
    "build:android": "npm run mkdist && react-native bundle --entry-file index.js --platform android --dev true --bundle-output dist/main.android.jsbundle --assets-dest dist && react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "npm run mkdist && react-native bundle --entry-file index.js --platform ios --dev true --bundle-output dist/main.ios.jsbundle --assets-dest dist && react-native build-ios --mode Debug",
    "ios": "react-native run-ios",
    "start": "react-native start"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2",
    "@react-native-community/netinfo": "^12.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-webrtc": "^124.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@rnx-kit/metro-config": "^2.2.5",
    "@types/react": "^19.2.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-monorepo-config": "^0.4.0",
    "react-native-test-app": "^5.4.12"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
